generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  OPEN
  PAUSED
  CLOSED
}

enum ApplicationStatus {
  NEW
  SCREENING
  PHONE_SCREEN
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum ParseStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

enum ParseJobStatus {
  QUEUED
  PROCESSING
  COMPLETE
  FAILED
}

enum ApplicationSource {
  APPLY_FORM
  EMAIL
  REFERRAL
  MANUAL
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  activities    Activity[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionToken])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Job {
  id           String              @id @default(cuid())
  title        String
  reqCode      String              @unique
  ingestAlias  String              @unique
  status       JobStatus           @default(OPEN)
  createdAt    DateTime            @default(now())
  applications Application[]
  inbound      InboundMessage[]
  parseJobs    ParseJob[]
}

model Candidate {
  id              String        @id @default(cuid())
  firstName       String?
  lastName        String?
  email           String?
  phone           String?
  location        String?
  currentTitle    String?
  currentEmployer String?
  linkedinUrl     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  applications    Application[]
  documents       Document[]
  activities      Activity[]
  unroutedEmails  UnroutedEmail[]
  forwarding      ForwardingVerification[]

  @@index([email])
  @@index([phone])
}

model Application {
  id         String            @id @default(cuid())
  candidateId String
  jobId      String
  status     ApplicationStatus @default(NEW)
  source     ApplicationSource @default(MANUAL)
  screening  Json?
  appliedAt  DateTime          @default(now())
  candidate  Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job        Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  documents  Document[]
  activities Activity[]

  @@unique([candidateId, jobId])
  @@index([jobId, appliedAt])
  @@index([status])
  @@index([source, appliedAt])
  @@index([jobId, source])
}

model Document {
  id            String      @id @default(cuid())
  candidateId   String?
  applicationId String?
  s3Key         String      @unique
  filename      String
  mimeType      String
  sizeBytes     Int
  extractedText String?
  parsedData    Json?
  parseStatus   ParseStatus @default(PENDING)
  parsedAt      DateTime?
  candidate     Candidate?  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  parseJob      ParseJob?

  @@index([candidateId, parseStatus])
}

model ParseJob {
  id         String        @id @default(cuid())
  documentId String        @unique
  jobId      String
  status     ParseJobStatus @default(QUEUED)
  attempts   Int           @default(0)
  lastError  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  document   Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  job        Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model InboundMessage {
  id          String    @id @default(cuid())
  messageId   String    @unique
  fromAddress String
  toAddress   String
  subject     String?
  receivedAt  DateTime  @default(now())
  jobId       String?
  job         Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  attachments Json

  @@index([receivedAt])
}

model UnroutedEmail {
  id          String    @id @default(cuid())
  messageId   String    @unique
  fromAddress String
  toAddress   String
  subject     String?
  payload     Json
  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
}

model ForwardingVerification {
  id          String    @id @default(cuid())
  messageId   String    @unique
  code        String
  fromAddress String
  rawSubject  String?
  createdAt   DateTime  @default(now())
  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
}

model Activity {
  id           String   @id @default(cuid())
  applicationId String?
  candidateId   String
  type         String
  payload      Json
  actorId      String?
  createdAt    DateTime @default(now())
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  application  Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([candidateId, createdAt])
  @@index([applicationId, createdAt])
}