generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  OPEN
  PAUSED
  CLOSED
}

enum ParseStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

enum ParseJobStatus {
  QUEUED
  PROCESSING
  COMPLETE
  FAILED
}

enum ApplicationSource {
  APPLY_FORM
  EMAIL
  REFERRAL
  MANUAL
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  activities    Activity[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionToken])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Job {
  id           String              @id @default(cuid())
  title        String
  reqCode      String              @unique
  ingestAlias  String              @unique
  status       JobStatus           @default(OPEN)
  createdAt    DateTime            @default(now())
  applications Application[]
  inbound      InboundMessage[]
  parseJobs    ParseJob[]
}

model Candidate {
  id              String        @id @default(cuid())
  firstName       String?
  lastName        String?
  email           String?
  phone           String?
  location        String?
  currentTitle    String?
  currentEmployer String?
  linkedinUrl     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  applications    Application[]
  documents       Document[]
  activities      Activity[]
  unroutedEmails  UnroutedEmail[]
  forwarding      ForwardingVerification[]

  @@index([email])
  @@index([phone])
}

model Application {
  id         String            @id @default(cuid())
  candidateId String
  jobId      String?
  statusId   String
  source     ApplicationSource @default(MANUAL)
  screening  Json?
  appliedAt  DateTime          @default(now())
  autoRejectedRuleId String?
  autoRejectedReason String?
  firstCalledAt      DateTime?
  candidate  Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job        Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  statusRef  Status            @relation(fields: [statusId], references: [id], onDelete: Restrict)
  documents  Document[]
  activities Activity[]
  formResponses FormResponse[]

  @@unique([candidateId, jobId])
  @@index([jobId, appliedAt])
  @@index([source, appliedAt])
  @@index([jobId, source])
}

model Document {
  id            String      @id @default(cuid())
  candidateId   String?
  applicationId String?
  s3Key         String      @unique
  filename      String
  mimeType      String
  sizeBytes     Int
  extractedText String?
  parsedData    Json?
  parseStatus   ParseStatus @default(PENDING)
  parsedAt      DateTime?
  candidate     Candidate?  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  parseJob      ParseJob?

  @@index([candidateId, parseStatus])
}

model ParseJob {
  id         String        @id @default(cuid())
  documentId String        @unique
  jobId      String
  status     ParseJobStatus @default(QUEUED)
  attempts   Int           @default(0)
  lastError  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  document   Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  job        Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model InboundMessage {
  id          String    @id @default(cuid())
  messageId   String    @unique
  fromAddress String
  toAddress   String
  subject     String?
  receivedAt  DateTime  @default(now())
  jobId       String?
  job         Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  attachments Json

  @@index([receivedAt])
}

model UnroutedEmail {
  id          String    @id @default(cuid())
  messageId   String    @unique
  fromAddress String
  toAddress   String
  subject     String?
  payload     Json
  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
}

model ForwardingVerification {
  id          String    @id @default(cuid())
  messageId   String    @unique
  code        String
  fromAddress String
  rawSubject  String?
  createdAt   DateTime  @default(now())
  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
}

enum StatusCountsAs {
  ACCEPTED
  REJECTED
  OPEN
}

/// User-editable pipeline stage. Replaces the ApplicationStatus enum in Phase 4;
/// both exist during the transition so no application loses its state.
model Status {
  id         String         @id @default(cuid())
  key        String         @unique
  label      String
  color      String
  order      Int
  isTerminal Boolean        @default(false)
  /// Deactivated statuses keep their applications and their history; they are
  /// simply no longer offered when moving an application.
  active     Boolean        @default(true)
  countsAs   StatusCountsAs @default(OPEN)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  applications Application[]

  @@index([order])
}

enum RuleOperator {
  EQUALS
  NOT_EQUALS
  CONTAINS
  IS_EMPTY
  IS_TRUE
  IS_FALSE
}

enum RuleAction {
  REJECT
  FLAG
}

/// A disqualifier evaluated once at submission. questionKey references a field
/// key from the FormDefinition the submission came from.
model Rule {
  id           String       @id @default(cuid())
  name         String
  questionKey  String
  operator     RuleOperator
  value        String?
  action       RuleAction   @default(REJECT)
  reason       String
  active       Boolean      @default(true)
  priority     Int          @default(0)
  formDefinitionId String?
  formDefinition   FormDefinition? @relation(fields: [formDefinitionId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([active, priority])
}

/// JSON array of fields plus consent text. Powers the builder, the public apply
/// page, and the export.
model FormDefinition {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  fields      Json
  consentText String
  version     Int      @default(1)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rules       Rule[]
  responses   FormResponse[]

  @@index([published])
}

/// One submission. consentTextSnapshot is the exact text shown at the time,
/// never a reference to the current version.
model FormResponse {
  id                  String   @id @default(cuid())
  applicationId       String
  formDefinitionId    String?
  formVersion         Int?
  answers             Json
  consentTextSnapshot String
  submittedAt         DateTime @default(now())
  application         Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  formDefinition      FormDefinition? @relation(fields: [formDefinitionId], references: [id], onDelete: SetNull)

  @@index([applicationId])
}

model Activity {
  id           String   @id @default(cuid())
  applicationId String?
  candidateId   String
  type         String
  payload      Json
  body         String?
  pinned       Boolean  @default(false)
  actorId      String?
  createdAt    DateTime @default(now())
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  application  Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([candidateId, createdAt])
  @@index([applicationId, createdAt])
}