DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ats"
AUTH_SECRET="replace-with-a-long-random-value"
AUTH_URL="http://localhost:3000"
EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
EMAIL_FROM="ATS <no-reply@example.com>"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="ats-documents"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
POSTMARK_WEBHOOK_USERNAME=""
POSTMARK_WEBHOOK_PASSWORD=""
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-haiku-latest"

# The requisition /apply files into, matched on Job.ingestAlias.
# Without a Job at this alias with status OPEN, /apply returns 409 for every
# submission. Seed one with: npm run seed:caregiver-job
CAREGIVER_JOB_ALIAS="caregiver"